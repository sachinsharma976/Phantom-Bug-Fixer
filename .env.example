# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# --- JIRA ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_PROJECT_KEY=BUG
# JQL used to fetch tickets when JIRA_PROJECT_KEY / defaults aren't enough
JIRA_JQL=project = BUG AND status = "To Do" AND assignee = currentUser() ORDER BY priority DESC
# Label added to a ticket once phantom-bug-fixer has opened a PR for it
JIRA_PROCESSED_LABEL=phantom-bug-fixer-attempted

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org
GITHUB_REPO=your-nextjs-repo
GITHUB_BASE_BRANCH=main
# Local path the target repo is cloned into / already checked out at
REPO_WORKSPACE_DIR=./workspace/repo

# --- Agent behavior ---
MAX_FIX_ITERATIONS=5
TEST_RUNNER_COMMAND=npm test
DRY_RUN=false
LOG_LEVEL=info
